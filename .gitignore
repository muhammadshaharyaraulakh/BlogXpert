/vendor/
composer.phar

# ===================================================
# Environment & Sensitive Configuration
# ===================================================
.env
.env.*
!.env.example
config/config.php
!config/config.example.php

# ===================================================
# User & Dynamic Uploads
# ===================================================
# Ignore uploaded post images but preserve Hero banner and gitkeep
images/*
!images/Hero.png
!images/.gitkeep

# Ignore uploaded user avatar images but preserve gitkeep
userImages/*
!userImages/.gitkeep

